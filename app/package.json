{
  "name": "starter-app",
  "version": "1.0.0",
  "description": "CleanSlice Nuxt App Starter Kit",
  "private": true,
  "type": "module",
  "scripts": {
    "build:api": "openapi-ts",
    "predev": "bun run build:api",
    "dev": "nuxt dev --port 4226",
    "build": "bun run build:api && nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "lint": "eslint \"slices/**/*.{ts,vue}\" \"*.{ts,vue}\" --fix",
    "format": "prettier --write \"slices/**/*.{ts,vue}\" \"*.{ts,vue}\""
  },
  "dependencies": {
    "@lucide/vue": "^1.79.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@pinia/nuxt": "^1.0.3",
    "@tanstack/vue-table": "^9.3.1",
    "@vueuse/core": "^15.1.0",
    "axios": "^1.21.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "inversify": "^8.3.0",
    "nuxt": "^4.7.0",
    "pinia": "^4.1.0",
    "reflect-metadata": "^0.2.2",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@hey-api/openapi-ts": "^0.99.0",
    "@tailwindcss/vite": "^4.3.5",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "shadcn-nuxt": "^2.9.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
