{
  "name": "starter-app",
  "version": "1.0.0",
  "description": "CleanSlice Nuxt App Starter Kit",
  "private": true,
  "scripts": {
    "build:api": "openapi-ts",
    "predev": "bun run build:api",
    "dev": "nuxt dev --port 4226",
    "build": "bun run build:api && nuxt build",
    "start": "nuxt start",
    "generate": "nuxt generate",
    "lint": "eslint \"slices/**/*.{ts,vue}\" \"*.{ts,vue}\" --fix",
    "format": "prettier --write \"slices/**/*.{ts,vue}\" \"*.{ts,vue}\""
  },
  "dependencies": {
    "@nuxtjs/color-mode": "^4.1.0",
    "@pinia/nuxt": "^0.11.3",
    "@tanstack/vue-table": "^8.21.3",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.21.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "inversify": "^7.11.0",
    "lucide-vue-next": "^0.460.0",
    "nuxt": "^4.6.4",
    "pinia": "^3.0.4",
    "reflect-metadata": "^0.2.2",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^2.6.1",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@hey-api/openapi-ts": "^0.93.1",
    "@tailwindcss/vite": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^16.5.0",
    "prettier": "^3.9.10",
    "shadcn-nuxt": "^2.9.0",
    "tailwindcss": "^4.3.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1"
  }
}
