// use prisma-8
// @scope:api
// @slice:user
// @layer:data
// @type:prisma

model User {
  id        String   @id // user-<adjective>-<noun>-<12 Crockford>, minted by the gateway
  email     String   @unique
  name      String
  password  String
  roles     String[]
  verified  Boolean  @default(false)
  banned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @onCreate(now()) @onUpdate(now())
}
