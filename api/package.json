{
  "name": "starter-api",
  "version": "1.0.0",
  "description": "CleanSlice NestJS API Starter Kit",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "generate:swagger": "node dist/generate-swagger.js",
    "start": "nest start",
    "cleanslice": "node scripts/cleanslice-check.cjs",
    "predev": "npm run cleanslice && npm run docker && npm run generate && npm run migrate",
    "dev": "cross-env NODE_ENV=dev nest start --watch",
    "start:prod": "npx prisma migrate deploy && node dist/main",
    "docker": "docker compose up -d",
    "generate": "npx prisma-import --force",
    "premigrate": "npx prisma-import --force",
    "migrate": "npx dotenv-cli -e .env.dev -- npx prisma migrate dev && npx dotenv-cli -e .env.dev -- npx prisma generate",
    "studio": "npx dotenv-cli -e .env.dev -- npx prisma studio",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.29",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.29",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.29",
    "@nestjs/swagger": "^11.4.6",
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cross-env": "^7.0.3",
    "helmet": "^8.3.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.29",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "@eslint/js": "^9.39.5",
    "dependency-cruiser": "^16.10.4",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "prettier": "^3.9.6",
    "typescript-eslint": "^8.67.0",
    "prisma": "^6.19.3",
    "prisma-import": "^1.0.5",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  },
  "prisma": {
    "import": {
      "schemas": "./src/**/!(schema).prisma",
      "output": "./prisma/schema.prisma"
    }
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^#setup/(.*)$": "<rootDir>/slices/setup/$1",
      "^#user/(.*)$": "<rootDir>/user/$1"
    }
  }
}
