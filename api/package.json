{
  "name": "starter-api",
  "version": "1.0.0",
  "description": "CleanSlice NestJS API Starter Kit",
  "private": true,
  "license": "MIT",
  "scripts": {
    "postinstall": "prisma contract emit --format human --quiet",
    "prisma:emit": "prisma contract emit --format human --quiet",
    "build": "prisma contract emit --format human --quiet && nest build",
    "typecheck": "prisma contract emit --format human --quiet && tsc --noEmit -p tsconfig.json",
    "generate:swagger": "node dist/generate-swagger.js",
    "start": "nest start",
    "check": "node scripts/cleanslice-check.cjs",
    "predev": "bun run check && bun run docker && bun run db:deploy",
    "dev": "export PORT=${PORT:-4229}; prisma contract emit --format human --quiet && cross-env NODE_ENV=dev nest start --watch",
    "start:prod": "node scripts/migrate.mjs && node dist/main",
    "docker": "docker compose up -d --wait",
    "db:deploy": "node --env-file-if-exists=.env.dev --env-file-if-exists=.env scripts/migrate.mjs",
    "db:status": "node --env-file-if-exists=.env.dev --env-file-if-exists=.env node_modules/prisma/dist/prisma.js migration status --to deploy --format human",
    "db:plan": "node --env-file-if-exists=.env.dev --env-file-if-exists=.env node_modules/prisma/dist/prisma.js migration plan --from deploy --format human",
    "db:verify": "node --env-file-if-exists=.env.dev --env-file-if-exists=.env node_modules/prisma/dist/prisma.js db verify --format human",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "test": "prisma contract emit --format human --quiet && NODE_OPTIONS=--experimental-vm-modules jest",
    "test:watch": "prisma contract emit --format human --quiet && NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:cov": "prisma contract emit --format human --quiet && NODE_OPTIONS=--experimental-vm-modules jest --coverage"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/orm-postgres": "8.0.0-rc.14",
    "bcrypt": "^6.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "cross-env": "^7.0.3",
    "helmet": "^8.0.0",
    "human-id": "4.1.3",
    "nanoid": "3.3.11",
    "nodemailer": "^10.0.16",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "8.23.1",
    "reflect-metadata": "^0.2.0",
    "rxjs": "^7.8.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.2.7",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "8.23.1",
    "dependency-cruiser": "^18.5.0",
    "dotenv-cli": "^8.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "jest": "^30.0.0",
    "prettier": "^3.9.9",
    "prisma": "8.0.0-rc.19",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.4.14",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.71.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.(spec|e2e-spec)\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": [
        "ts-jest",
        {
          "tsconfig": "<rootDir>/../tsconfig.json"
        }
      ]
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^#setup/(.*)$": "<rootDir>/slices/setup/$1",
      "^#user/(.*)$": "<rootDir>/slices/user/$1"
    },
    "setupFiles": [
      "<rootDir>/../test/env.cjs"
    ],
    "globalSetup": "<rootDir>/../test/globalSetup.cjs",
    "maxWorkers": 1
  },
  "engines": {
    "node": ">=22.18"
  },
  "trustedDependencies": [
    "bcrypt",
    "esbuild",
    "prisma"
  ],
  "overrides": {
    "@prisma/orm-toolchain": "8.0.0-rc.14",
    "@prisma/orm-framework": "8.0.0-rc.14"
  }
}
