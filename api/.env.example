# APPLICATION
NODE_ENV=dev
PORT=4226
CORS_ORIGIN=http://localhost:4227,http://localhost:4228

# DATABASE (PostgreSQL via Docker)
DATABASE_URL=postgresql://postgres:root@localhost:4230/cleanslice-api-local-database

# AUTHENTICATION
JWT_SECRET=your-secret-change-in-production
JWT_EXPIRES_IN=7d

# EMAIL (SMTP; locally Mailpit via Docker, inbox at http://localhost:4232)
SMTP_HOST=localhost
SMTP_PORT=4231
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CleanSlice <noreply@cleanslice.local>
